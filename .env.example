# Copy to .env and adjust as needed.
# The bundled container (docker compose up -d mongo) publishes on 27018, not
# the default 27017, so it cannot be shadowed by a MongoDB already running on
# this machine. Point this at your own instance if you would rather use that.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=medication_ai
PORT=4100

# How often the agent loop wakes up to process due escalations, in milliseconds.
AGENT_TICK_MS=15000

# Set to "false" to stop the agent loop from starting with the server
# (useful when you want to drive ticks manually via POST /api/agent/tick).
AGENT_LOOP_ENABLED=true

# --- Push notifications -----------------------------------------------------
# Generate a pair with `npm run vapid`, then paste them here. Without them the
# server reports push as unconfigured and the app says so, rather than sending
# reminders nowhere. Rotating the pair unsubscribes every registered device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
